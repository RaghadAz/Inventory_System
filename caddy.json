{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [":10000"],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": ["/"]
                  },
                  "status_code": 308
                }
              ],
              "match": [
                {
                  "host": ["*"],
                  "path": ["/index.php"]
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "localhost:8000"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": ["*"]
                }
              ]
            }
          ]
        }
      }
    }
  }
}
